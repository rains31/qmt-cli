# ===== QMT cfquant CLI 配置样例 =====
# 复制本文件为 .env (与本脚本同目录), 或 ~/.qmt_cli.env

# cfquant 服务地址 (必填)。若服务端有前置 Basic 认证, 可直接内嵌:
# CFQUANT_BASE_URL=https://user:pass@your-cfquant-server.example.com
CFQUANT_BASE_URL=https://your-cfquant-server.example.com

# API Key (如服务端开启了鉴权则必填)
CFQUANT_API_KEY=your-api-key-here

# 默认操作账号 (必填)
CFQUANT_ACCOUNT_ID=1234567890
# 账号类型: STOCK(普通) / CREDIT(信用)
CFQUANT_ACCOUNT_TYPE=STOCK

# 可选: 账号列表 (供 accounts 命令与 use 命令 Tab 补全)
# 格式: 账号:类型:昵称;账号2:类型2:昵称2
CFQUANT_ACCOUNTS=1234567890:STOCK:普通账户;10987654321:CREDIT:信用账户
